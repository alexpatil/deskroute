// prisma/schema.prisma

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    SYSTEM_ADMIN
    STAFF
    ADMIN
}

enum Priority {
    LOW
    NORMAL
    HIGH
    URGENT
}

enum Plan {
    FREE
    STARTER
    PRO
}

// ── Core application models ────────────────────────────────────────────────

model User {
    id                   String        @id @default(cuid())
    name                 String
    firstName            String?
    lastName             String?
    email                String        @unique
    emailVerified        Boolean       @default(false)
    image                String?
    // Application-specific fields
    role                 UserRole      @default(STAFF)
    organizationId       String?
    organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    assignedLocationId   String?
    assignedLocation     Location?     @relation(fields: [assignedLocationId], references: [id], onDelete: SetNull)
    canViewAllFiles      Boolean       @default(false)
    canManageOffices     Boolean       @default(false)
    canManageStaff       Boolean       @default(false)
    canConfigureStatuses Boolean       @default(false)
    canManageLocations   Boolean       @default(false)
    createdAt            DateTime      @default(now())
    updatedAt            DateTime      @updatedAt
    // Better Auth relations
    sessions             Session[]
    accounts             Account[]
    auditLogs            AuditLog[]
    invitationsSent      Invitation[]  @relation("InvitedBy")

    @@index([email])
    @@index([organizationId])
    @@index([assignedLocationId])
}

model Organization {
    id           String       @id @default(cuid())
    name         String
    slug         String?      @unique
    industry     String?
    settings     Json         @default("{}")
    plan         Plan         @default(FREE)
    isActive     Boolean      @default(true)
    // 14-day free trial: set when the organization is created. Null is treated
    // as expired by getTrialStatus. bypassTrial exempts an org from the gate.
    trialEndsAt  DateTime?
    bypassTrial  Boolean      @default(false)
    // Monotonic counter used to assign human-friendly, per-organization
    // sequential file numbers (see File.fileNumber). Incremented atomically.
    fileSeq      Int          @default(0)
    ownerUserId  String       @unique
    users        User[]
    locations    Location[]
    files        File[]
    fileStatuses FileStatus[]
    auditLogs    AuditLog[]
    invitations  Invitation[]
    createdAt    DateTime     @default(now())
    updatedAt    DateTime     @updatedAt

    @@index([ownerUserId])
    @@index([slug])
}

model Location {
    id              String        @id @default(cuid())
    name            String
    type            String        @default("Branch")
    organizationId  String
    organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    assignedUsers   User[]
    filesAtLocation File[]        @relation("FileCurrentLocation")
    historyFrom     FileHistory[] @relation("HistoryFromLocation")
    historyTo       FileHistory[] @relation("HistoryToLocation")
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt

    @@index([organizationId])
    @@index([type])
}

model FileStatus {
    id             String        @id @default(cuid())
    name           String
    isEnabled      Boolean       @default(true)
    organizationId String
    organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    files          File[]
    history        FileHistory[]
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@index([organizationId])
    @@index([isEnabled])
}

model File {
    id                String        @id @default(cuid())
    trackingNumber    String        @unique @default(cuid())
    // Human-friendly sequential number, unique within an organization. Easy to
    // hand-write at offices that don't print the QR code. Nullable so files
    // created before this field existed remain valid.
    fileNumber        Int?
    referenceId       String?
    subjectName       String
    category          String
    priority          Priority      @default(NORMAL)
    dueDate           DateTime?
    description       String?
    currentLocationId String
    currentLocation   Location      @relation("FileCurrentLocation", fields: [currentLocationId], references: [id])
    currentStatusId   String
    currentStatus     FileStatus    @relation(fields: [currentStatusId], references: [id])
    isCompleted       Boolean       @default(false)
    completedAt       DateTime?
    organizationId    String
    organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    history           FileHistory[]
    createdAt         DateTime      @default(now())
    updatedAt         DateTime      @updatedAt

    @@unique([organizationId, fileNumber])
    @@index([organizationId])
    @@index([isCompleted])
    @@index([currentLocationId])
    @@index([currentStatusId])
    @@index([trackingNumber])
}

model FileHistory {
    id              String     @id @default(cuid())
    fileId          String
    file            File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
    fromLocationId  String?
    fromLocation    Location?  @relation("HistoryFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
    toLocationId    String
    toLocation      Location   @relation("HistoryToLocation", fields: [toLocationId], references: [id])
    statusId        String
    status          FileStatus @relation(fields: [statusId], references: [id])
    locationChanged Boolean    @default(true)
    statusChanged   Boolean    @default(true)
    oldStatusName   String?
    newStatusName   String?
    createdAt       DateTime   @default(now())

    @@index([fileId])
    @@index([toLocationId])
    @@index([statusId])
}

model AuditLog {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    userId         String
    user           User         @relation(fields: [userId], references: [id])
    action         String
    entityType     String
    entityId       String
    metadata       Json?
    ipAddress      String?
    createdAt      DateTime     @default(now())

    @@index([organizationId, createdAt])
    @@index([entityId])
    @@index([userId])
}

model Invitation {
    id             String       @id @default(cuid())
    email          String
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    role           String       @default("STAFF")
    permissions    Json         @default("{}")
    invitedById    String
    invitedBy      User         @relation("InvitedBy", fields: [invitedById], references: [id])
    token          String       @unique @default(cuid())
    expiresAt      DateTime
    acceptedAt     DateTime?
    createdAt      DateTime     @default(now())

    @@index([token])
    @@index([organizationId])
    @@index([email])
}

// ── Better Auth models ─────────────────────────────────────────────────────

model Session {
    id        String   @id
    expiresAt DateTime
    token     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([token])
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@unique([providerId, accountId])
    @@index([userId])
}

model Verification {
    id         String    @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime? @default(now())
    updatedAt  DateTime? @updatedAt

    @@index([identifier])
}
